{
  "name": "smart-task-manager",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "apps/hub",
    "apps/voicescribe",
    "apps/voicescribe/web",
    "apps/voicescribe/desktop",
    "apps/content-web",
    "apps/content-desktop",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck --workspace=apps/desktop && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/hub && npm run typecheck --workspace=apps/voicescribe && npm run typecheck --workspace=@voicescribe/web && npm run typecheck --workspace=packages/cm-core && npm run typecheck --workspace=apps/content-web && npm run typecheck --workspace=apps/content-desktop",
    "typecheck:clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:hub": "npm run dev --workspace=apps/hub",
    "build:hub": "npm run build --workspace=apps/hub",
    "smoke-test:voicescribe": "npm run smoke-test --workspace=apps/voicescribe --",
    "dev:voicescribe-web": "npm run dev --workspace=@voicescribe/web",
    "build:voicescribe-web": "npm run build --workspace=@voicescribe/web",
    "tauri:hub": "npm run tauri --workspace=apps/hub --",
    "dev:hub-tauri": "npm run tauri --workspace=apps/hub -- dev",
    "build:hub-tauri": "npm run tauri --workspace=apps/hub -- build",
    "tauri": "npm run tauri --workspace=apps/desktop --",
    "dev:tauri": "npm run tauri --workspace=apps/desktop -- dev",
    "build:tauri": "npm run tauri --workspace=apps/desktop -- build",
    "android:run": "npm run android:run --workspace=apps/web",
    "android:build-debug": "npm run android:build-debug --workspace=apps/web",
    "android:open": "npm run android:open --workspace=apps/web",
    "ios:open": "npm run ios:open --workspace=apps/web",
    "dev:vs-desktop": "npm run tauri --workspace=@voicescribe/desktop -- dev",
    "build:vs-tauri": "npm run tauri --workspace=@voicescribe/desktop -- build",
    "dev:cm-web": "npm run dev --workspace=apps/content-web",
    "build:cm-web": "npm run build --workspace=apps/content-web",
    "dev:cm-desktop": "npm run dev --workspace=apps/content-desktop",
    "tauri:cm": "npm run tauri --workspace=apps/content-desktop --",
    "dev:cm-tauri": "npm run tauri --workspace=apps/content-desktop -- dev",
    "build:cm-tauri": "npm run tauri --workspace=apps/content-desktop -- build",
    "cm:android-open": "npm run android:open --workspace=apps/content-web",
    "cm:up": "docker compose -f docker-compose.content-manager.yml up -d --build",
    "cm:down": "docker compose -f docker-compose.content-manager.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
