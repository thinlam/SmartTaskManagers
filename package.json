{
  "name": "smart-task-manager",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck --workspace=apps/desktop && npm run typecheck --workspace=apps/web",
    "typecheck:clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "tauri": "npm run tauri --workspace=apps/desktop --",
    "dev:tauri": "npm run tauri --workspace=apps/desktop -- dev",
    "build:tauri": "npm run tauri --workspace=apps/desktop -- build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
