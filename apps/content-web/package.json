{
  "name": "@cm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "ios:open": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@cm/core": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
