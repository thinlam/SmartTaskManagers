{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "smart-task-manager",
  "version": "0.1.0",
  "identifier": "com.smarttaskmanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Task Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "lâm Nguyên Thìn",
    "copyright": "© 2026 lâm Nguyên Thìn",
    "category": "Productivity",
    "shortDescription": "Personal task, project, goal and habit manager",
    "longDescription": "Smart Task Manager is a personal productivity app for tracking tasks, projects, goals and habits, with a rule-based Smart Engine that scores and prioritizes your work. Syncs with a local backend and, optionally, a Google Sheets workbook.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "Smart Task Manager"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
