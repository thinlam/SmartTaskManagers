{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://*.githubusercontent.com/*" }
      ]
    },
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "$APPCACHE/**" },
        { "path": "$APPDATA/**" },
        { "path": "$LOCALDATA/smart-task-manager/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "msiexec", "cmd": "msiexec", "args": true },
        {
          "name": "smart-task-manager-installer",
          "cmd": "$APPCACHE/smart-task-manager-0.1.0.exe",
          "args": true
        }
      ]
    },
    "store:default"
  ]
}
