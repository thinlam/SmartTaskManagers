{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "giaotrinh-app-hub",
  "version": "0.1.1",
  "identifier": "com.giaotrinhcode.apphub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GiaoTrinh Code — App Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "lâm Nguyên Thìn",
    "copyright": "© 2026 lâm Nguyên Thìn",
    "category": "Productivity",
    "shortDescription": "Browse and download GiaoTrinh Code apps",
    "longDescription": "GiaoTrinh Code App Hub is a desktop launcher for discovering, downloading and updating the GiaoTrinh Code app suite (Smart Task Manager, Office add-ins and more).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "GiaoTrinh Code"
      }
    }
  }
}
