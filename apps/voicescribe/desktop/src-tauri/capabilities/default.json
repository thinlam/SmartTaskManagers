{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$DOWNLOAD/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$DOWNLOAD/**" }] }
  ]
}
