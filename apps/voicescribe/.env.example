HF_TOKEN=hf_your_token_here

# PostgreSQL. Local: docker compose -f docker-compose.voicescribe.yml up -d
# On Railway this is the Postgres plugin's DATABASE_URL.
DATABASE_URL=postgres://vs:vs_dev_password@localhost:5434/voicescribe

# Required in production (>= 32 random characters). A dev default is used locally.
JWT_SECRET=

# Optional invite code. When set, registering requires it (recommended when deployed,
# otherwise anyone who finds the URL can sign up and spend the Hugging Face quota).
SIGNUP_CODE=
