{
  "name": "@voicescribe/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --pretty && vite build",
    "build:desktop": "tsc --noEmit --pretty && vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "diff": "^5.2.0",
    "docx": "^9.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/diff": "^5.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
