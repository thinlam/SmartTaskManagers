# Copy this file to .env.development and .env.production (both gitignored —
# see repo root .gitignore) and fill in the value for each environment.
# Vite loads .env.development for `vite`, .env.production for
# `vite build` — no extra flags needed, it's automatic based on the
# command's default mode. See apps/web/src/main.tsx.

# Local backend (dotnet run, Properties/launchSettings.json's default port):
# VITE_API_BASE_URL=http://localhost:5277

# Deployed backend (e.g. Railway) — no trailing slash:
# VITE_API_BASE_URL=https://xxxxx.up.railway.app
VITE_API_BASE_URL=
