<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3b0a4478-a26f-4c7e-94be-2cd370eb7641</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned above the version Microsoft.AspNetCore.OpenApi 10.0.9 pulls in transitively (2.0.0),
         which has a known high-severity vulnerability (GHSA-v5pm-xwqc-g5wc). Staying on the 2.x
         line (not 3.x) on purpose: Microsoft.AspNetCore.OpenApi 10.0.9's source generator targets
         Microsoft.OpenApi 2.x's API shape — 3.x made IOpenApiMediaType.Example read-only, which
         breaks that generator at build time (verified: it does). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartTask.Application\SmartTask.Application.csproj" />
    <ProjectReference Include="..\SmartTask.Infrastructure\SmartTask.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartTask.Persistence\SmartTask.Persistence.csproj" />
  </ItemGroup>

</Project>
