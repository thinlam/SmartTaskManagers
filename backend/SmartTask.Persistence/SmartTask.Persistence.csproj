<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmartTask.Application\SmartTask.Application.csproj" />
    <ProjectReference Include="..\SmartTask.Domain\SmartTask.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MySQL provider — Microting.EntityFrameworkCore.MySql is a maintained fork of
         Pomelo.EntityFrameworkCore.MySql that targets EF Core 10 / net10.0 (the official
         Pomelo package is still on EF Core 9). Same API: UseMySql / ServerVersion. -->
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only (IDesignTimeDbContextFactory below) — the real connection
         string never lives in committed config, so dotnet ef needs a factory that
         works without one. Not shipped to the runtime image. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
